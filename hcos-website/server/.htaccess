# ============================================================================
# HCOS website — Apache / cPanel
#
# Place this file in the document root alongside index.html (i.e. inside the
# unpacked dist/ folder). Requires mod_rewrite, mod_headers, mod_expires and
# mod_deflate — all standard on cPanel / shared hosting.
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS and the bare domain.
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://hcosservices.com%{REQUEST_URI} [L,R=301]

    # /about.html -> /about  (canonical, extension-less)
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # /about -> about.html   (clean URLs)
    # Checked BEFORE the directory test on purpose: /events and /newsroom are
    # both a page (events.html) and a folder (events/<slug>.html). Without this
    # order Apache redirects /events -> /events/ and then serves a 403.
    # /events/ and /newsroom/ (trailing slash) serve the page directly rather
    # than redirecting back to /events: browsers cache 301s, and a redirect in
    # each direction — even briefly — leaves them looping until the cache clears.
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+)/$ $1.php [L,QSA]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)/$ $1.html [L]

    # /index.php, /events.php ... -> canonical clean URLs (external requests only;
    # %{ENV:REDIRECT_STATUS} is set once an internal rewrite has happened)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^index.php$ / [R=301,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(events|contact|share).php$ /$1 [R=301,L]

    # --- PHP-rendered routes (see site/src/server/) ---------------------------
    # /events/<slug>/share/<token>   attendee upload page
    RewriteRule ^events/([a-z0-9-]+)/share/([a-f0-9]{64})/?$ share.php?slug=$1&t=$2 [L,QSA]
    # /events/<slug>                 event page
    RewriteRule ^events/([a-z0-9-]+)/?$ events.php?slug=$1 [L,QSA]
    # /api/<name>                    api/<name>.php
    RewriteRule ^api/([a-z]+)/?$ api/$1.php [L,QSA]

    # /about -> about.php or about.html (clean URLs)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Stop mod_dir adding a trailing slash to /events and /newsroom.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

ErrorDocument 404 /404.html

# --- Caching ----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Compression --------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# --- Never expose build tooling or application internals ------------------------
<FilesMatch "^(build.js|serve.js|check-links.js|router-dev.php|package.json|schema.sql|config.example.php)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(src|_app)(/|$)

# --- PHP hardening (also set in code; belt and braces) --------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>
